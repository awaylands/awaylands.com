{
  "manifest_version": 3,
  "name": "Away Lands TakeShape Editor Styling",
  "version": "2.0.49",
  "description": "Adds the Away Lands editing layout, product tools, media controls, and title search to TakeShape.",
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://www.awaylands.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://app.takeshape.io/*"
      ],
      "js": [
        "takeshape-api-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://app.takeshape.io/*"
      ],
      "css": [
        "takeshape-editor.css"
      ],
      "js": [
        "takeshape-editor.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://rvlv.me/*"
      ],
      "js": [
        "revolve-product.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
