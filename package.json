{
  "private": true,
  "name": "awaylands.com",
  "version": "1.2.0",
  "description": "Website for Away Lands",
  "author": "Ronik Design <account@ronikdesign.com>",
  "generator": "slush-gh-pages v2.0.4",
  "license": "UNLICENSED",
  "homepage": "https://github.com/awaylands/awaylands.com",
  "repository": "git://github.com/awaylands/awaylands.com.git",
  "bugs": {
    "url": "https://github.com/awaylands/awaylands.com.git/issues"
  },
  "engines": {
    "node": ">= 18.0.0"
  },
  "scripts": {
    "init": "takeshape init",
    "clean": "rm -rf build/assets/javascripts && rm -rf build/assets/stylesheets && rm -rf build/assets/images && rm -f build/assets/*.json",
    "lint:js": "eslint src/javascripts",
    "lint:css": "stylelint src/stylesheets/**/*.scss --syntax scss",
    "lint": "npm-run-all -p lint:*",
    "imagemin": "imagemin src/images/* -o build/assets/images",
    "images:dev": "cp -R src/images build/assets/images",
    "copy:static": "node scripts/copy-static-assets.js",
    "serve": "npm run copy:static && node -e 'setTimeout(function() {}, 2000)' && browser-sync start --server build --port 5000 --files 'build/**/*, !build/sitemap.xml, !build/feed.xml' --reload-debounce",
    "serve:stories": "node scripts/story-preview-server.js",
    "story:editor": "node scripts/story-editor-server.js",
    "story:importer": "node scripts/story-importer-server.js",
    "takeshape:build": "takeshape build && npm run docs-images:localize && npm run story-links:sanitize",
    "docs-images:localize": "node scripts/localize-google-doc-images.js",
    "story-links:sanitize": "node scripts/sanitize-story-links.js",
    "build:images": "npm run imagemin",
    "build:images:dev": "npm run images:dev",
    "build:webpack": "NODE_ENV=production webpack --mode production --stats-error-details",
    "build:webpack:dev": "webpack --mode development --stats-error-details",
    "build": "npm-run-all --serial clean build:images build:webpack copy:static",
    "still:grid": "node scripts/still-grid-organizer.js",
    "slugs:dry-run": "node scripts/fill-story-slugs.js",
    "slugs:fill": "node scripts/fill-story-slugs.js --apply",
    "verify:production": "node scripts/verify-production-baseline.js",
    "deploy:production": "node scripts/deploy-production.js",
    "deploy": "npm run deploy:production",
    "watch:js": "webpack --watch",
    "watch:images": "chokidar 'src/images/**/*' -d -c 'npm run build:images'",
    "watch:takeshape": "takeshape watch",
    "watch": "npm-run-all --serial clean build:images:dev build:webpack:dev takeshape:build && npm-run-all --continue-on-error --parallel watch:* serve",
    "start": "npm run watch"
  },
  "devDependencies": {
    "@takeshape/cli": "^12.17.3",
    "@babel/core": "^7.28.5",
    "@babel/plugin-transform-runtime": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "autoprefixer": "^10.4.24",
    "babel-eslint": "^6.1.2",
    "babel-loader": "^9.2.1",
    "browser-sync": "^2.15.0",
    "chokidar-cli": "^1.2.0",
    "css-loader": "^7.1.2",
    "cssnano": "^7.1.2",
    "drive-in": "^1.5.2",
    "eslint": "^3.4.0",
    "eslint-config-xo-space": "^0.14.0",
    "eslint-plugin-babel": "^3.3.0",
    "html-loader": "^5.1.0",
    "imagemin-cli": "^3.0.0",
    "lost": "^9.0.2",
    "mini-css-extract-plugin": "^2.9.4",
    "mkdirp": "^0.5.1",
    "npm-run-all": "^3.1.0",
    "postcss": "^8.5.6",
    "postcss-custom-media": "^11.0.6",
    "postcss-loader": "^8.2.0",
    "postcss-media-minmax": "^5.0.0",
    "postcss-urlrev": "^3.0.1",
    "sass": "^1.93.3",
    "sass-loader": "^16.0.6",
    "style-loader": "^4.0.0",
    "stylelint": "^7.2.0",
    "stylelint-config-standard": "^13.0.0",
    "vue-loader": "^15.11.1",
    "webpack": "^5.102.1",
    "webpack-cli": "^5.1.4",
    "webpack-manifest-plugin": "^5.0.1"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.4",
    "imagesloaded": "^4.1.3",
    "object-fit-images": "^2.3.1",
    "raf-ready": "^1.0.1",
    "shufflejs": "^4.2.0",
    "takeshape-routing": "^5.0.4",
    "vue": "^2.7.16",
    "vue-template-compiler": "^2.7.16",
    "whatwg-fetch": "^3.0.0",
    "yaml-loader": "^0.8.1"
  },
  "main": "index.js"
}
