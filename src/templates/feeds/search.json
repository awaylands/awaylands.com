{# Match the browser search plainText function while omitting unused HTML. #}
{% macro searchTextJson(value) -%}
  {{- (value or "") | replace(r/<[^>]*>/g, " ") | replace(r/&[^;\s]+;/g, " ") | replace(r/\s+/g, " ") | trim | dump | safe -}}
{%- endmacro %}
      [
{% for category in categories.items %}
  {% if category.title != "* Most Popular Posts *" %}
  {
    "type": "category",
    "title": {{ category.title | dump | safe }},
    "url": {% if category.parentCategory and category.parentCategory.title != category.title %}{{ (category | route('subcategory')) | dump | safe }}{% else %}{{ (category | route('category')) | dump | safe }}{% endif %},
    "category": "Category page",
    "location": "",
    "dek": "",
    "image": ""
  },
  {% endif %}
{% endfor %}
{% set storyPages = [stories1.items, stories2.items, stories3.items, stories4.items] %}
{% for stories in storyPages %}
{% set lastPage = loop.last %}
{% for story in stories %}
  {% set searchCategories = [] %}
  {% for category in story.mainCategory %}{% if category.title not in searchCategories %}{% set ignored = searchCategories.push(category.title) %}{% endif %}{% endfor %}
  {% for category in story.category %}{% if category.title not in searchCategories %}{% set ignored = searchCategories.push(category.title) %}{% endif %}{% endfor %}
  {
    "title": {{ story.title | dump | safe }},
    "url": {% if story.slug %}{{ (story | route('storySlug')) | dump | safe }}{% else %}{{ (story | route('story')) | dump | safe }}{% endif %},
    "date": {{ (story._enabledAt | date("MMMM D, YYYY")) | dump | safe }},
    "isImportant": {% if story.isImportant == true %}true{% else %}false{% endif %},
    "category": {% if story.category.length %}{{ story.category[0].title | dump | safe }}{% else %}""{% endif %},
    "categories": [{% for category in searchCategories %}{% if not loop.first %},{% endif %}{{ category | dump | safe }}{% endfor %}],
    "location": {% if story.location.length %}{{ story.location[0].title | dump | safe }}{% else %}""{% endif %},
    "dek": {% if story.tout.dek %}{{ story.tout.dek | dump | safe }}{% elif story.social.description %}{{ story.social.description | dump | safe }}{% else %}""{% endif %},
    "image": {% if story.tout.image.path %}{{ (story.tout.image.path | image({w: 900, auto: 'compress,format'})) | dump | safe }}{% else %}""{% endif %},
    "content": {{ searchTextJson(story.contentHtml) }},
    "mainBlocks": [
      {% if story.mainHtmlBlock1 %}{{ searchTextJson(story.mainHtmlBlock1) }}{% else %}""{% endif %},
      {% if story.mainContentBlock1Html %}{{ searchTextJson(story.mainContentBlock1Html) }}{% else %}""{% endif %},
      {% if story.additionalMainBlocks and story.additionalMainBlocks.mainHtmlBlock2 %}{{ searchTextJson(story.additionalMainBlocks.mainHtmlBlock2) }}{% else %}""{% endif %},
      {% if story.additionalMainBlocks and story.additionalMainBlocks.mainContentBlock2Html %}{{ searchTextJson(story.additionalMainBlocks.mainContentBlock2Html) }}{% else %}""{% endif %},
      {% if story.additionalMainBlocks and story.additionalMainBlocks.mainHtmlBlock3 %}{{ searchTextJson(story.additionalMainBlocks.mainHtmlBlock3) }}{% else %}""{% endif %},
      {% if story.additionalMainBlocks and story.additionalMainBlocks.mainContentBlock3Html %}{{ searchTextJson(story.additionalMainBlocks.mainContentBlock3Html) }}{% else %}""{% endif %},
      {% if story.additionalMainBlocks and story.additionalMainBlocks.mainHtmlBlock4 %}{{ searchTextJson(story.additionalMainBlocks.mainHtmlBlock4) }}{% else %}""{% endif %},
      {% if story.additionalMainBlocks and story.additionalMainBlocks.mainContentBlock4Html %}{{ searchTextJson(story.additionalMainBlocks.mainContentBlock4Html) }}{% else %}""{% endif %},
      {% if story.additionalMainBlocks and story.additionalMainBlocks.mainHtmlBlock5 %}{{ searchTextJson(story.additionalMainBlocks.mainHtmlBlock5) }}{% else %}""{% endif %},
      {% if story.additionalMainBlocks and story.additionalMainBlocks.mainContentBlock5Html %}{{ searchTextJson(story.additionalMainBlocks.mainContentBlock5Html) }}{% else %}""{% endif %},
      {% if story.additionalMainBlocks and story.additionalMainBlocks.mainHtmlBlock6 %}{{ searchTextJson(story.additionalMainBlocks.mainHtmlBlock6) }}{% else %}""{% endif %},
      {% if story.additionalMainBlocks and story.additionalMainBlocks.mainContentBlock6Html %}{{ searchTextJson(story.additionalMainBlocks.mainContentBlock6Html) }}{% else %}""{% endif %},
      {% if story.mainHtmlBlock2 %}{{ searchTextJson(story.mainHtmlBlock2) }}{% else %}""{% endif %},
      {% if story.mainContentBlock2Html %}{{ searchTextJson(story.mainContentBlock2Html) }}{% else %}""{% endif %},
      {% if story.mainHtmlBlock3 %}{{ searchTextJson(story.mainHtmlBlock3) }}{% else %}""{% endif %},
      {% if story.mainContentBlock3Html %}{{ searchTextJson(story.mainContentBlock3Html) }}{% else %}""{% endif %},
      {% if story.mainHtmlBlock4 %}{{ searchTextJson(story.mainHtmlBlock4) }}{% else %}""{% endif %},
      {% if story.mainContentBlock4Html %}{{ searchTextJson(story.mainContentBlock4Html) }}{% else %}""{% endif %},
      {% if story.mainHtmlBlock5 %}{{ searchTextJson(story.mainHtmlBlock5) }}{% else %}""{% endif %},
      {% if story.mainContentBlock5Html %}{{ searchTextJson(story.mainContentBlock5Html) }}{% else %}""{% endif %},
      {% if story.mainHtmlBlock6 %}{{ searchTextJson(story.mainHtmlBlock6) }}{% else %}""{% endif %},
      {% if story.mainContentBlock6Html %}{{ searchTextJson(story.mainContentBlock6Html) }}{% else %}""{% endif %}
    ],
    "blocks": [
      {% for block in story.contentBlocks %}
        {% if block.__typename == "ContentBlock" %}
          {{ searchTextJson(block.contentHtml) }}
        {% elif block.__typename == "HtmlBlock" %}
          {{ searchTextJson(block.html) }}
        {% elif block.__typename == "TableBlock" %}
          {{ searchTextJson((block.pastedText or "")) }}
        {% else %}
          ""
        {% endif %}{% if not loop.last %},{% endif %}
      {% endfor %}
    ],
    "extraContentBlocks": [
      {% for block in story.extraContentBlocks %}{{ searchTextJson(block.contentHtml) }}{% if not loop.last %},{% endif %}{% endfor %}
    ],
    "extraHtmlBlocks": [
      {% for block in story.extraHtmlBlocks %}{{ searchTextJson(block.html) }}{% if not loop.last %},{% endif %}{% endfor %}
    ],
    "extraTableBlocks": [
      {% for block in story.extraTableBlocks %}{{ searchTextJson(block.pastedText) }}{% if not loop.last %},{% endif %}{% endfor %}
    ]
  }{% if not loop.last or not lastPage %},{% endif %}
{% endfor %}
      {% endfor %}
      ]
